{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "codex-switch",
  "version": "0.1.0",
  "identifier": "com.codexswitch.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:3000",
    "beforeDevCommand": "pnpm run dev:renderer",
    "beforeBuildCommand": "pnpm run build:renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "codex-switch",
        "width": 420,
        "height": 600,
        "minWidth": 380,
        "minHeight": 520,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: asset: http://asset.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* https:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/.codex-switch/icons/providers/**"]
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["codexswitch", "ccswitch"]
      }
    }
  }
}
